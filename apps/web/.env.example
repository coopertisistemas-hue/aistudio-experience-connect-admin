# Environment variables for Experience Connect — Vercel Preview/Staging
# Copy these into your Vercel project settings → Environment Variables
#
# REQUIRED: the app hard-fails at runtime if these are missing.
# See: apps/web/src/lib/supabase.ts

VITE_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
VITE_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: base path for subdirectory deploys (defaults to "/")
# BASE_PATH=/
